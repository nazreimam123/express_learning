<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>
        Data will be here
    </h1>
    <table border="1" >
        <tr>
            <td>Name</td>
            <td>Age</td>
            <td>Email</td>
            <td>Operation</td>
            <td>Update</td>
        </tr>
        <tr>
            <% result.forEach(element => { %>
                <tr>
            <td><%= element.name %></td>
            <td><%= element.age %></td>
            <td><%= element.email %></td>
            <!-- <td><%= element._id %></td> -->
             <td><a href="/ui/delete/<%=element._id %>">Delete</a></td>
             <td><a href="/ui/student/<%=element._id %>">Update</a></td>
        </tr> 
           <% }) %>
        </tr>
        
    </table>
</body>
</html>